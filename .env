# Configurações da Aplicação
ENVIRONMENT=development
PORT=8000
ALLOWED_ORIGINS=*
RATE_LIMIT_PER_MIN=120
MAX_UPLOAD_SIZE_MB=100
MAX_MEMORY_MULTIPART_MB=32

# MinIO S3 Object Storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=138B9bu6y5
MINIO_USE_SSL=false
MINIO_DEFAULT_BUCKET=users-file
MINIO_REGION=us-east-1

# Golang Auth API Integration (https://github.com/gjovanovicst/golang-auth-api)
AUTH_API_URL=http://localhost:8080
JWT_SECRET_KEY=138B9bu6y5138B9bu6y5138B9bu6y513
JWT_ISSUER=golang-auth-api
# "local_signature" ou "remote_introspection"
AUTH_VALIDATION_MODE=local_signature
PRESIGNED_EXPIRY_TTL=15m
